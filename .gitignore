# dependencies and build output
node_modules/
out/
dist/

# installers, reports, promo renders (regenerated by npm run dist / render)
output/

# local ASR model, 233 MB — download from k2-fsa/sherpa-onnx releases (see CLAUDE.md)
data/

# scratch files
tmp/
promo/tmp/

# promo: music can't be redistributed on its own (Mixkit licence / ElevenLabs plan);
# the Feishu screenshot shows a real name and is for local use only
promo/public/music.wav
promo/public/open-audio.wav
# open-source video: screenshots (comments show other people's names and avatars), regenerated by scripts
promo/public/open/
promo/public/music/*.mp3
promo/public/apps/feishu-chat.png

# never commit secrets
.env
.env.*
*.log

# python bytecode
__pycache__/
.wrangler/
