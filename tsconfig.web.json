{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*",
    "src/preload/api.d.ts"
  ]
}
